---
---

<!-- Section 9: VIP Lead Capture Form -->
<section id="vip-form" class="py-20 sm:py-24 bg-gradient-to-b from-bg-dark to-bg-offblack border-t border-white/10 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    
    <!-- Left Copy & VIP Benefits -->
    <div class="space-y-6">
      <span data-i18n="form.tag" class="text-xs uppercase tracking-[0.3em] text-gold font-headline font-bold block">Exclusive Priority Registration</span>
      <h2 data-i18n="form.title" class="text-3xl sm:text-4xl md:text-5xl font-black font-headline text-white leading-tight">
        Claim Your <span class="text-gold-gradient">VIP Buyer Access</span> & Private Inventory
      </h2>
      <p data-i18n="form.desc" class="text-white/80 text-sm sm:text-base font-light leading-relaxed">
        Register your interest now to receive priority unit selection, direct developer payment incentives, and official floor plan brochures before public release.
      </p>

      <div class="space-y-4 pt-4 border-t border-white/10">
        <div class="flex items-center gap-3 text-xs sm:text-sm text-white/90">
          <div class="w-5 h-5 rounded-full bg-gold/20 border border-gold/50 flex items-center justify-center text-gold flex-shrink-0">
            <svg class="w-3 h-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <span data-i18n="form.check1">Priority Unit Allocation before Public Launch</span>
        </div>
        <div class="flex items-center gap-3 text-xs sm:text-sm text-white/90">
          <div class="w-5 h-5 rounded-full bg-gold/20 border border-gold/50 flex items-center justify-center text-gold flex-shrink-0">
            <svg class="w-3 h-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <span data-i18n="form.check2">1-on-1 VIP Consultation with Senior Property Advisor</span>
        </div>
        <div class="flex items-center gap-3 text-xs sm:text-sm text-white/90">
          <div class="w-5 h-5 rounded-full bg-gold/20 border border-gold/50 flex items-center justify-center text-gold flex-shrink-0">
            <svg class="w-3 h-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <span data-i18n="form.check3">Instant Floor Plan PDF & Pricing Sheet Delivery</span>
        </div>
      </div>
    </div>

    <!-- Right VIP Lead Form -->
    <div class="glass-card p-6 sm:p-8 rounded-2xl border-2 border-gold/50 shadow-2xl relative bg-bg-card">
      <h3 data-i18n="form.formTitle" class="text-2xl font-bold font-headline text-white mb-2 text-center">Book VIP Consultation</h3>
      <p data-i18n="form.formSub" class="text-xs text-white/70 text-center mb-6">Fill out the form below to receive immediate access.</p>

      <form id="leadCaptureForm" class="space-y-4">
        <div>
          <label data-i18n="form.lblFullName" class="block text-xs font-headline text-white font-semibold uppercase tracking-wider mb-1">Full Name *</label>
          <input
            type="text"
            name="full_name"
            required
            data-i18n-placeholder="form.phFullName"
            placeholder="e.g. Alexander Vance"
            class="w-full px-4 py-3 rounded-xl bg-black border border-white/30 text-white placeholder-white/50 focus:border-gold focus:outline-none transition-colors text-sm"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label data-i18n="form.lblWhatsApp" class="block text-xs font-headline text-white font-semibold uppercase tracking-wider mb-1">WhatsApp Number *</label>
            <input
              type="tel"
              name="whatsapp_number"
              required
              data-i18n-placeholder="form.phWhatsApp"
              placeholder="+971 50 123 4567"
              class="w-full px-4 py-3 rounded-xl bg-black border border-white/30 text-white placeholder-white/50 focus:border-gold focus:outline-none transition-colors text-sm"
            />
          </div>

          <div>
            <label data-i18n="form.lblEmail" class="block text-xs font-headline text-white font-semibold uppercase tracking-wider mb-1">Email Address *</label>
            <input
              type="email"
              name="email"
              required
              data-i18n-placeholder="form.phEmail"
              placeholder="alexander@example.com"
              class="w-full px-4 py-3 rounded-xl bg-black border border-white/30 text-white placeholder-white/50 focus:border-gold focus:outline-none transition-colors text-sm"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label data-i18n="form.lblBudget" class="block text-xs font-headline text-white font-semibold uppercase tracking-wider mb-1">Investment Budget</label>
            <select
              name="budget_range"
              class="w-full px-4 py-3 rounded-xl bg-black border border-white/30 text-white focus:border-gold focus:outline-none transition-colors text-sm"
            >
              <option value="$300k-$500k">$300,000 – $500,000</option>
              <option value="$500k-$1M" selected>$500,000 – $1,000,000</option>
              <option value="$1M+">$1,000,000+</option>
            </select>
          </div>

          <div>
            <label data-i18n="form.lblPurpose" class="block text-xs font-headline text-white font-semibold uppercase tracking-wider mb-1">Purchase Purpose</label>
            <select
              name="investment_purpose"
              class="w-full px-4 py-3 rounded-xl bg-black border border-white/30 text-white focus:border-gold focus:outline-none transition-colors text-sm"
            >
              <option data-i18n="form.optInvestment" value="Investment">Investment (High ROI)</option>
              <option data-i18n="form.optSelfUse" value="Self-use">Self-use Residence</option>
            </select>
          </div>
        </div>

        <div id="formMessage" class="hidden text-xs font-semibold text-center p-3 rounded-lg"></div>

        <!-- High-Contrast Guaranteed Visible Submit Button -->
        <button
          type="submit"
          id="submitBtn"
          data-i18n="form.btnSubmit"
          style="background: linear-gradient(135deg, #FFF099 0%, #D4AF37 50%, #F59E0B 100%) !important; color: #000000 !important; font-weight: 900 !important; font-size: 13px !important;"
          class="w-full py-4 rounded-xl font-headline uppercase tracking-wider hover:scale-[1.02] transition-transform duration-300 shadow-[0_0_25px_rgba(212,175,55,0.6)] cursor-pointer"
        >
          Book VIP Consultation / Get Availability
        </button>
      </form>
    </div>

  </div>
</section>

<script>
  import { updateDOMTranslations } from '../lib/i18n.js';

  const form = document.getElementById('leadCaptureForm') as HTMLFormElement;
  const messageBox = document.getElementById('formMessage');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      submitBtn.disabled = true;
      submitBtn.innerText = 'Submitting VIP Registration...';
      messageBox?.classList.add('hidden');

      const formData = new FormData(form);
      const payload = {
        full_name: formData.get('full_name')?.toString() || '',
        whatsapp_number: formData.get('whatsapp_number')?.toString() || '',
        email: formData.get('email')?.toString() || '',
        budget_range: formData.get('budget_range')?.toString() || '$500k-$1M',
        investment_purpose: formData.get('investment_purpose')?.toString() || 'Investment',
        lead_source: 'Website VIP Form'
      };

      const newLead = {
        id: `lead-${Date.now()}`,
        full_name: payload.full_name,
        whatsapp_number: payload.whatsapp_number,
        email: payload.email,
        budget_range: payload.budget_range,
        investment_purpose: payload.investment_purpose,
        status: 'new',
        created_at: new Date().toISOString()
      };

      // Save locally to localStorage so Dashboard picks it up immediately
      try {
        const existing = JSON.parse(localStorage.getItem('binghatti_submitted_leads') || '[]');
        const updated = [newLead, ...existing];
        localStorage.setItem('binghatti_submitted_leads', JSON.stringify(updated));
      } catch (err) {}

      // Submit to backend API
      try {
        const API_BASE = (import.meta.env && import.meta.env.PUBLIC_API_URL) ? import.meta.env.PUBLIC_API_URL : (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' ? 'http://localhost:8085' : 'https://binghatti-royal.onrender.com');
        await fetch(${API_BASE}/api/v1/leads, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch (err: any) {
        console.warn('Backend API request skipped/offline, lead saved locally', err);
      }

      messageBox?.classList.remove('hidden');
      messageBox?.classList.add('bg-gold/20', 'text-gold', 'border', 'border-gold/40');
      messageBox!.innerText = 'Registration Successful! Our VIP Senior Advisor will contact you on WhatsApp shortly.';
      form.reset();

      submitBtn.disabled = false;
      const currentLang = localStorage.getItem('binghatti_lang') || 'en';
      updateDOMTranslations(currentLang);
    });
  }
</script>
