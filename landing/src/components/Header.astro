---
import CurrencyToggle from './CurrencyToggle.svelte';
import LanguageSwitcher from './LanguageSwitcher.svelte';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-black/90 backdrop-blur-xl border-b border-gold/40 px-4 sm:px-6 py-3.5 transition-all">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-2 shrink-0">
      <span data-i18n="nav.brand" class="font-headline font-black text-xl sm:text-2xl tracking-widest text-gold">BINGHATTI</span>
      <span data-i18n="nav.sub" class="hidden lg:inline text-[9px] uppercase tracking-widest text-white/80 border-l border-white/20 pl-2">
        Luxury Residences
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-xs font-headline uppercase tracking-wider font-bold text-white">
      <a href="#vision" data-i18n="nav.vision" class="hover:text-gold transition-colors">Vision</a>
      <a href="#floor-plans" data-i18n="nav.residences" class="hover:text-gold transition-colors">Residences</a>
      <a href="#amenities" data-i18n="nav.amenities" class="hover:text-gold transition-colors">Amenities</a>
      <a href="#location" data-i18n="nav.location" class="hover:text-gold transition-colors">Location</a>
      <a href="#payment" data-i18n="nav.payment" class="hover:text-gold transition-colors">Payment Plan</a>
    </nav>

    <!-- Interactive Controls & Action CTA -->
    <div class="flex items-center gap-2 sm:gap-3">
      <CurrencyToggle client:load />
      <LanguageSwitcher client:load />

      <a
        href="#vip-form"
        data-i18n="nav.inquire"
        style="background: linear-gradient(135deg, #FFF099 0%, #D4AF37 50%, #F59E0B 100%) !important; color: #000000 !important; font-weight: 800 !important;"
        class="hidden sm:inline-block px-4 py-2 rounded-xl font-headline font-bold text-xs uppercase tracking-wider hover:scale-105 shadow-[0_0_15px_rgba(212,175,55,0.5)] transition-all cursor-pointer"
      >
        Inquire Now
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-gold hover:bg-white/10 transition-colors"
        aria-label="Toggle Navigation Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden pt-4 pb-3 px-3 space-y-1.5 border-t border-white/10 mt-3 text-start">
    <a href="#vision" data-i18n="nav.vision" class="block py-2.5 px-3 rounded-xl text-sm font-semibold text-white hover:text-gold hover:bg-white/5 transition-colors">Vision</a>
    <a href="#floor-plans" data-i18n="nav.residences" class="block py-2.5 px-3 rounded-xl text-sm font-semibold text-white hover:text-gold hover:bg-white/5 transition-colors">Residences</a>
    <a href="#amenities" data-i18n="nav.amenities" class="block py-2.5 px-3 rounded-xl text-sm font-semibold text-white hover:text-gold hover:bg-white/5 transition-colors">Amenities</a>
    <a href="#location" data-i18n="nav.location" class="block py-2.5 px-3 rounded-xl text-sm font-semibold text-white hover:text-gold hover:bg-white/5 transition-colors">Location</a>
    <a href="#payment" data-i18n="nav.payment" class="block py-2.5 px-3 rounded-xl text-sm font-semibold text-white hover:text-gold hover:bg-white/5 transition-colors">Payment Plan</a>
    <a href="#vip-form" data-i18n="nav.inquire" style="background: #D4AF37; color: #000; font-weight: 800;" class="block w-full py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider">Inquire Now</a>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
