---
const highlights = [
  {
    id: "h-price",
    svg: `<svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
  },
  {
    id: "h-payment",
    svg: `<svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`
  },
  {
    id: "h-booking",
    svg: `<svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>`
  },
  {
    id: "h-visa",
    svg: `<svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>`
  }
];
---

<section id="highlights" class="relative z-20 -mt-6 sm:-mt-8 max-w-7xl mx-auto px-4 sm:px-6">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 p-3 sm:p-5 rounded-2xl glass-card border border-gold/40 shadow-[0_15px_35px_rgba(0,0,0,0.9)]">
    {highlights.map((item) => (
      <div class="flex items-center gap-2.5 sm:gap-4 p-3 sm:p-4 rounded-xl bg-black/60 border border-white/10 hover:border-gold/50 transition-all">
        <div class="p-2 sm:p-3 rounded-xl bg-gold/15 border border-gold/40 text-gold flex items-center justify-center shrink-0 shadow-[0_0_15px_rgba(212,175,55,0.2)]" set:html={item.svg}>
        </div>
        <div class="min-w-0">
          <span id={`${item.id}-lbl`} class="block text-[9px] sm:text-[10px] uppercase font-headline tracking-wider text-white/70 font-semibold mb-0.5 truncate">
            HIGHLIGHT
          </span>
          <span id={`${item.id}-val`} class="text-sm sm:text-2xl font-black font-headline text-gold block truncate">
            --
          </span>
          <span id={`${item.id}-sub`} class="block text-[10px] sm:text-xs font-medium text-white/90 truncate">
            --
          </span>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { translations } from '../lib/translations.js';
  import { convertAEDShort } from '../lib/currencyFormatter.js';

  function updateHighlightCurrency(curr: string) {
    const pVal = document.getElementById('h-price-val');
    if (pVal) {
      pVal.innerText = convertAEDShort(1200000, curr);
    }
  }

  function updateHighlights(lang: string) {
    const t = translations[lang] || translations.en;
    const h = t.highlights;

    const pLbl = document.getElementById('h-price-lbl');
    const pSub = document.getElementById('h-price-sub');

    const payLbl = document.getElementById('h-payment-lbl');
    const payVal = document.getElementById('h-payment-val');
    const paySub = document.getElementById('h-payment-sub');

    const bLbl = document.getElementById('h-booking-lbl');
    const bVal = document.getElementById('h-booking-val');
    const bSub = document.getElementById('h-booking-sub');

    const vLbl = document.getElementById('h-visa-lbl');
    const vVal = document.getElementById('h-visa-val');
    const vSub = document.getElementById('h-visa-sub');

    if (pLbl) pLbl.innerText = h.priceLabel;
    if (pSub) pSub.innerText = h.priceSub;

    if (payLbl) payLbl.innerText = h.paymentLabel;
    if (payVal) payVal.innerText = h.paymentVal;
    if (paySub) paySub.innerText = h.paymentSub;

    if (bLbl) bLbl.innerText = h.bookingLabel;
    if (bVal) bVal.innerText = h.bookingVal;
    if (bSub) bSub.innerText = h.bookingSub;

    if (vLbl) vLbl.innerText = h.visaLabel;
    if (vVal) vVal.innerText = h.visaVal;
    if (vSub) vSub.innerText = h.visaSub;
  }

  window.addEventListener('languageChange', (e: any) => {
    updateHighlights(e.detail.lang);
  });

  window.addEventListener('currencyChange', (e: any) => {
    updateHighlightCurrency(e.detail.currency);
  });

  const savedLang = localStorage.getItem('binghatti_lang') || 'en';
  updateHighlights(savedLang);

  const savedCurr = localStorage.getItem('binghatti_currency') || 'AED';
  updateHighlightCurrency(savedCurr);
</script>
