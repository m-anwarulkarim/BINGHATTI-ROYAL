---
const benefits = [
  { id: "b1" },
  { id: "b2" },
  { id: "b3" }
];
---

<section id="invest" class="py-20 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <span id="invest-tag" class="text-xs uppercase tracking-[0.3em] text-gold font-headline font-bold block mb-2">Global Investor Haven</span>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-black font-headline text-white mb-4">
      <span id="invest-t1">WHY INVEST IN</span> <span id="invest-t2" class="text-gold-gradient">DUBAI REAL ESTATE?</span>
    </h2>
    <p id="invest-desc" class="text-white/80 text-sm sm:text-base font-light">
      Dubai remains the world's #1 destination for capital protection, high rental yields, and luxury lifestyle.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {benefits.map((item) => (
      <div class="glass-card glass-card-hover p-8 rounded-2xl border-gold/30 flex flex-col justify-between relative overflow-hidden">
        <div id={`invest-badge-${item.id}`} class="absolute -top-3 -right-3 px-4 py-1 rounded-bl-xl bg-gold text-black font-headline font-extrabold text-[10px] tracking-widest uppercase shadow-md">
          --
        </div>

        <div>
          <h3 id={`invest-title-${item.id}`} class="text-2xl font-bold font-headline text-white mb-2">--</h3>
          <span id={`invest-hl-${item.id}`} class="text-xs uppercase tracking-wider text-gold font-bold block mb-4">--</span>
          <p id={`invest-d-${item.id}`} class="text-xs sm:text-sm text-white/80 font-light leading-relaxed mb-6">--</p>
        </div>

        <div class="pt-4 border-t border-white/10">
          <a href="#vip-form" id={`invest-btn-${item.id}`} class="text-xs uppercase font-headline tracking-widest font-bold text-gold hover:text-white flex items-center gap-2 transition-colors">
            <span>Claim Investor Guide</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { translations } from '../lib/translations.js';

  function updateInvestment(lang) {
    const t = translations[lang] || translations.en;
    const inv = t.investment;

    const tag = document.getElementById('invest-tag');
    const t1 = document.getElementById('invest-t1');
    const t2 = document.getElementById('invest-t2');
    const desc = document.getElementById('invest-desc');

    if (tag) tag.innerText = inv.tag;
    if (t1) t1.innerText = inv.title1;
    if (t2) t2.innerText = inv.title2;
    if (desc) desc.innerText = inv.desc;

    ['b1', 'b2', 'b3'].forEach(id => {
      const badge = document.getElementById(`invest-badge-${id}`);
      const title = document.getElementById(`invest-title-${id}`);
      const hl = document.getElementById(`invest-hl-${id}`);
      const d = document.getElementById(`invest-d-${id}`);
      const btn = document.getElementById(`invest-btn-${id}`);

      if (badge) badge.innerText = inv[`${id}Badge`];
      if (title) title.innerText = inv[`${id}Title`];
      if (hl) hl.innerText = inv[`${id}Highlight`];
      if (d) d.innerText = inv[`${id}Desc`];
      if (btn) btn.innerHTML = `<span>${inv.btnClaim}</span> <span>→</span>`;
    });
  }

  window.addEventListener('languageChange', (e: any) => {
    updateInvestment(e.detail.lang);
  });

  const savedLang = localStorage.getItem('binghatti_lang') || 'en';
  updateInvestment(savedLang);
</script>
